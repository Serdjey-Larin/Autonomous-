<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Верхняя панель статуса -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/status_dot"
            android:background="@color/error"
            android:layout_width="12dp"
            android:layout_height="12dp"/>

        <TextView
            android:id="@+id/status_text"
            android:text="Отключено"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <TextView
            android:text="AutonomousEye"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Видео + оверлей -->
    <FrameLayout
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/video_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.example.autonomouseye.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/counter_overlay"
            android:text=""
            android:textColor="@color/text_primary"
            android:background="#99000000"
            android:padding="8dp"
            android:textSize="13sp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>

    <!-- Нижняя панель управления -->
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/url_input"
            android:hint="rtsp://admin:123456@IP:554/0/av1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:inputType="textUri"
            android:singleLine="true"
            android:backgroundTint="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/play_btn"
                android:text="▶  Play"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/stop_btn"
                android:text="■  Stop"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/detect_btn"
                android:text="👁  Детектор"
                android:textSize="13sp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/service_btn"
                android:text="🌐  Сервис"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <Button
            android:id="@+id/stats_btn"
            android:text="📊  Статистика"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </LinearLayout>
</LinearLayout>
